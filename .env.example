# ─────────────────────────────────────────────────────────────────────────────
# GophProfile (Аватарница) — пример переменных окружения.
# Скопируйте файл в .env и при необходимости измените значения:
#   cp .env.example .env
# Значения ниже — дефолты для локального запуска (APP_ENV=local).
# ─────────────────────────────────────────────────────────────────────────────

# ─── App ─────────────────────────────────────────────────────────────────────
# Окружение: local | prod. В prod обязательные переменные должны быть заданы явно.
APP_ENV=local
# Уровень логирования: debug | info | warn | error.
LOG_LEVEL=info

# ─── Observability (OpenTelemetry) ───────────────────────────────────────────
# OTLP HTTP endpoint коллектора (Jaeger): именно HTTP-порт 4318, не gRPC 4317.
# Если коллектор недоступен — приложение не падает, спаны досылаются в фоне.
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# Базовое имя сервиса; к нему добавляется суффикс -server / -worker.
OTEL_SERVICE_NAME=gophprofile
OTEL_SERVICE_VERSION=dev
OTEL_ENVIRONMENT=dev

# ─── HTTP ────────────────────────────────────────────────────────────────────
HTTP_PORT=8080
HTTP_READ_TIMEOUT=10s
HTTP_WRITE_TIMEOUT=15s

# ─── PostgreSQL ──────────────────────────────────────────────────────────────
# ОБЯЗАТЕЛЬНО в prod: POSTGRES_HOST, POSTGRES_PORT, POSTGRES_USER,
#                     POSTGRES_PASSWORD, POSTGRES_DB
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=avatar
POSTGRES_PASSWORD=avatar
POSTGRES_DB=avatars
# Режим SSL: disable | require | verify-ca | verify-full
POSTGRES_SSLMODE=disable

# ─── S3 / MinIO ──────────────────────────────────────────────────────────────
# ОБЯЗАТЕЛЬНО в prod: S3_ENDPOINT, S3_ACCESS_KEY, S3_SECRET_KEY, S3_BUCKET
S3_ENDPOINT=localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=avatars
S3_REGION=us-east-1
S3_USE_SSL=false

# ─── RabbitMQ ────────────────────────────────────────────────────────────────
# ОБЯЗАТЕЛЬНО в prod: RABBITMQ_URL, RABBITMQ_EXCHANGE
RABBITMQ_URL=amqp://guest:guest@localhost:5672/
RABBITMQ_EXCHANGE=avatars.exchange

# ─── Docker Compose (только для локальной инфраструктуры) ────────────────────
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

RABBITMQ_DEFAULT_USER=guest
RABBITMQ_DEFAULT_PASS=guest
